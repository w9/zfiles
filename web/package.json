{
  "name": "zfiles-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-icons": "tsx scripts/generate-file-icons.mts",
    "predev": "pnpm generate-icons",
    "build": "pnpm generate-icons && tsc && vite build && node scripts/compress-dist.mjs",
    "build:cloud": "pnpm generate-icons && tsc && vite build --config vite.cloud.config.ts && node scripts/compress-dist.mjs dist-cloud",
    "dev:cloud": "vite --config vite.cloud.config.ts --open /index.cloud.html",
    "preview:cloud": "vite preview --config vite.cloud.config.ts --outDir dist-cloud",
    "preview": "vite preview",
    "test": "pnpm generate-icons && tsx --test src/theme.test.ts src/i18n/i18n.test.ts src/actions/*.test.ts src/listing-format.test.ts src/fileIcons.test.ts src/base64Utf8.test.ts src/api.test.ts src/backend/*.test.ts src/cloud/*.test.ts src/explorer/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/lib-storage": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1056.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "material-icon-theme": "^5.35.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
