#!/usr/bin/env python3
import base64
import json
import sys

# 1x1 red PNG
PNG = base64.b64decode(
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
)


def read_message():
    header = b""
    while not header.endswith(b"\r\n\r\n"):
        chunk = sys.stdin.buffer.read(1)
        if not chunk:
            return None
        header += chunk
    length = int(
        next(line.split(": ", 1)[1] for line in header.decode().split("\r\n") if line.startswith("Content-Length:"))
    )
    payload = sys.stdin.buffer.read(length)
    return json.loads(payload)


def write_message(message):
    payload = json.dumps(message).encode("utf-8")
    sys.stdout.buffer.write(f"Content-Length: {len(payload)}\r\n\r\n".encode("utf-8"))
    sys.stdout.buffer.write(payload)
    sys.stdout.buffer.flush()


while True:
    message = read_message()
    if message is None:
        break
    request_id = message.get("id")
    method = message.get("method")

    if method == "initialize":
        write_message({"jsonrpc": "2.0", "id": request_id, "result": {"ok": True}})
        continue

    if method == "thumbnailer/generate":
        write_message(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "result": {
                    "contentType": "image/png",
                    "data": base64.b64encode(PNG).decode("ascii"),
                },
            }
        )
        continue

    write_message(
        {
            "jsonrpc": "2.0",
            "id": request_id,
            "error": {"code": -32601, "message": f"unknown method {method}"},
        }
    )
